    "@newrelic/browser-agent": "^1.322.0",
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "next": "^16.3.6",
    "next-intl": "^4.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "sharp": "^0.35.4",
    "socket.io-client": "^4.8.3",
    "vinext": "^1.0.0-beta.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
